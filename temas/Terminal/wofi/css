/*WOFI TERMINAL*/
@define-color unfocused rgba(255, 167, 87,0.5);
@define-color text #FFA757;
@define-color border #FFA757;
*{
font-family:Terminess Nerd Font Mono;
font-weight:bold;
font-size:15px;
box-shadow: none;
background:transparent;
}
window{
background:black;
border:1px solid @border;
}
#entry,#entry:selected,#expander-box{
color:@unfocused;
padding:5px;
margin:5px;
}
#entry:selected #text{
color:@text;
}
#entry:selected{
border:1px solid @border;
}
img,#img{
margin:0px 10px 0px 0px;
height: 5px;
max-width: 10%;
max-height: 10%;
}
#input{
margin:1px;
border:none;
border-radius:0px;
}